# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# Port the API listens on (Render/other hosts set this automatically)
PORT=3000

# MongoDB connection string (Atlas: Database > Connect > Drivers).
# Include a database name before the "?" so data lands in a DB you recognise.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/shopeasy?retryWrites=true&w=majority

# Long random string used to sign tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Used only by "npm run seed:admin"
ADMIN_EMAIL=admin@shopeasy.com
ADMIN_PASSWORD=Admin1234!

# Optional: restrict CORS to your frontend (defaults to *)
# CLIENT_URL=http://localhost:5173
